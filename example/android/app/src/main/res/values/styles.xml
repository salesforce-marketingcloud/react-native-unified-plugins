<resources>
    <!-- Base application theme. RN's DayNight base theme is required so the framework's
         dialog / picker components render correctly on both light and dark devices. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:textColor">@android:color/black</item>
        <item name="android:statusBarColor">#021E40</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>

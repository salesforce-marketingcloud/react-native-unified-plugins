{
  "name": "react-native-unified-plugins",
  "private": true,
  "description": "React Native plugins for the Salesforce Marketing Cloud Unified Mobile SDK",
  "author": "Salesforce Marketing Cloud",
  "license": "BSD-3-Clause",
  "workspaces": [
    "packages/*",
    "example"
  ],
  "scripts": {
    "android": "cd example && yarn run android",
    "ios": "cd example && yarn run ios",
    "lint": "prettier --check 'packages/*/src/**/*.ts'",
    "format": "prettier --write 'packages/*/src/**/*.ts'",
    "prepare": "husky"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@react-native-community/cli": "^20.1.3",
    "@react-native-community/cli-platform-ios": "^20.1.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "lint-staged": {
    "packages/*/src/**/*.ts": ["prettier --write"]
  },
  "resolutions": {
    "react": "19.2.3",
    "react-native": "0.85.1",
    "@types/react": "^19.0.0"
  }
}

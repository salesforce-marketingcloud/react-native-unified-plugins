root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{ts,tsx,js,jsx,json}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[*.{kt,kts}]
indent_size = 4
max_line_length = 120
ktlint_code_style = android_studio
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

[*.{h,m,mm,swift}]
indent_size = 4

[*.{gradle,groovy}]
indent_size = 4

[Makefile]
indent_style = tab
